<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ezone.pae.registroproductos.controller.ProductoController">

    <children>

        <Label layoutX="350.0" layoutY="25.0" text="Registro de productos">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="100.0" text="Nombre:" />
        <Label layoutX="30.0" layoutY="140.0" text="Categoría:" />
        <Label layoutX="30.0" layoutY="180.0" text="Precio:" />
        <Label layoutX="30.0" layoutY="220.0" text="Fecha de ingreso:" />

        <TextField fx:id="txtNombre" layoutX="155.0" layoutY="95.0" prefHeight="30.0" prefWidth="230.0" promptText="Nombre del producto" />

        <TextField fx:id="txtCategoria" layoutX="155.0" layoutY="135.0" prefHeight="30.0" prefWidth="230.0" promptText="Categoría" />

        <TextField fx:id="txtPrecio" layoutX="155.0" layoutY="175.0" prefHeight="30.0" prefWidth="230.0" promptText="0.00" />

        <DatePicker fx:id="dtpFechaRegistro" layoutX="155.0" layoutY="215.0" prefHeight="30.0" prefWidth="180.0" />

        <Button fx:id="btnAgregar" layoutX="155.0" layoutY="265.0" mnemonicParsing="false" onAction="#agregarProducto" prefHeight="30.0" prefWidth="75.0" text="Agregar" />

        <Button fx:id="btnActualizar" layoutX="240.0" layoutY="265.0" mnemonicParsing="false" onAction="#actualizarProducto" prefHeight="30.0" prefWidth="85.0" text="Actualizar" />

        <Button fx:id="btnLimpiar" layoutX="335.0" layoutY="265.0" mnemonicParsing="false" onAction="#limpiarControles" prefHeight="30.0" prefWidth="70.0" text="Limpiar" />

        <Label layoutX="500.0" layoutY="95.0" text="Imagen del producto" />

        <ImageView fx:id="imgProducto" fitHeight="130.0" fitWidth="250.0" layoutX="500.0" layoutY="120.0" pickOnBounds="true" preserveRatio="true" />

        <Button fx:id="btnSeleccionarImagen" layoutX="500.0" layoutY="265.0" mnemonicParsing="false" onAction="#guardarImagen" prefHeight="30.0" prefWidth="135.0" text="Seleccionar imagen" />

        <Separator layoutX="25.0" layoutY="330.0" prefWidth="850.0" />

        <Label layoutX="30.0" layoutY="355.0" text="Productos registrados">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TableView fx:id="tblProductos" layoutX="46.0" layoutY="397.0" prefHeight="220.0" prefWidth="840.0">

            <columns>

                <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />

                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />

                <TableColumn fx:id="colCategoria" prefWidth="190.0" text="Categoría" />

                <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio" />

                <TableColumn fx:id="colFechaRegistro" prefWidth="188.0" text="Fecha de ingreso" />

            </columns>

        </TableView>

    </children>

</AnchorPane>
